# Shared secret the loggers send as "Authorization: Bearer <token>". Required, or /ingest returns 503.
RTD_API_TOKEN=change-me-to-a-long-random-string

# Protects the dashboard and /api/*. Leave the password empty only on a private network.
RTD_DASHBOARD_USER=admin
RTD_DASHBOARD_PASSWORD=change-me-too

# SQLite file. In Docker this is /data/rtd.db (mount a volume there).
RTD_DB=data/rtd.db
