# Copy to deploy/.env (git-ignored) and fill in.

# Public hostname of the server. With no domain of your own, use the server's static IP with dashes
# in front of .sslip.io, e.g. 13-232-10-20.sslip.io (Caddy gets a real certificate for it).
DOMAIN=13-232-10-20.sslip.io

# Dashboard login (HTTP Basic). Use a long random password.
RTD_DASHBOARD_USER=admin
RTD_DASHBOARD_PASSWORD=change-me

# Kept for the legacy HTTP /ingest endpoint; any long random string. Not used by the MQTT path.
RTD_API_TOKEN=change-me-too

# From aws_iot_setup.py's output, e.g. a3c0fn3vwuwpkv-ats.iot.ap-south-1.amazonaws.com
MQTT_HOST=your-endpoint-ats.iot.ap-south-1.amazonaws.com
